data_dir = "/var/lib/rune"

[server]
grpc_address = "${grpc_address}"
http_address = "${http_address}"

[log]
level  = "${log_level}"
format = "${log_format}"

[networking]
cluster_cidr = "${cluster_cidr}"

[telemetry]
metrics_addr = "${metrics_addr}"

[node]
role = "${node_role}"
%{ if acme_email != "" ~}

[acme]
email = "${acme_email}"
%{ endif ~}
%{ for r in docker_registries ~}

[[docker.registries]]
name     = "${r.name}"
registry = "${r.registry}"

  [docker.registries.auth]
  type = "${r.auth_type}"
%{ if r.auth_type == "basic" ~}
  username = "${r.username}"
  password = "${r.password}"
%{ endif ~}
%{ if r.auth_type == "token" ~}
  token = "${r.token}"
%{ endif ~}
%{ if r.auth_type == "ecr" ~}
  region = "${r.region}"
%{ endif ~}
%{ endfor ~}
